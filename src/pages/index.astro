---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;

// Organization JSON-LD a főoldalon
const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  name: "KAVICS",
  url: SITE.website,
  logo: new URL("/assets/logo.png", SITE.website).href,
  description: SITE.desc,
  email: "info@kavicsmedia.hu",
  sameAs: [
    "https://www.youtube.com/@kavicsmedia",
    "https://www.tiktok.com/@kavics_media",
    "https://www.instagram.com/kavics_media/",
  ],
});
---

<Layout title={`KAVICS — Riportok a magyar rögvalóságról`}>
  <script
    type="application/ld+json"
    set:html={organizationSchema}
    slot="head"
    is:inline
  />
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Megmutatjuk, ami van.</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="RSS csatorna"
        title="RSS csatorna"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS csatorna</span>
      </a>

      <p>
        Társadalmi riportok, tényfeltárás, dokumentarizmus — Magyarország azon
        részeiről, ahová a kamera ritkán jut el. Kommentár helyett kérdezünk.
        Ítélet helyett odamegyünk.
      </p>
      <div class="hero-buttons">
        <LinkButton
          href="/posts/"
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
        >
          Riportjaink →
        </LinkButton>
        <LinkButton
          href="/about/"
          className="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
        >
          Miért csináljuk? →
        </LinkButton>
      </div>
    </section>

    <Hr />

    <section id="mit-csinalunk">
      <h2>Mit csinálunk?</h2>
      <p>
        A KAVICS egy független dokumentarista YouTube-csatorna. Riportjainkban
        Magyarország falvait, közösségeit és társadalmi jelenségeit mutatjuk be
        — szenzáció és leegyszerűsítés nélkül.
      </p>
      <p>
        Nem mondjuk meg, mit gondolj. Elmegyünk, végighallgatjuk az embereket,
        és úgy adjuk tovább, ahogy elmondták. A többi a nézőé.
      </p>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <h2>Kiemelt riportok</h2>
            <ul>
              {featuredPosts.map(({ data, slug }) => (
                <Card
                  href={`/posts/${slug}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Legfrissebb riportok</h2>
          <ul>
            {recentPosts.map(
              ({ data, slug }, index) =>
                index < 3 && (
                  <Card
                    href={`/posts/${slug}/`}
                    frontmatter={data}
                    secHeading={false}
                  />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        Összes riport
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>

    <Hr />

    <section id="hol-talalsz">
      <h2>Hol találsz minket?</h2>
      <p>
        A KAVICS elsősorban a YouTube-on él, de ott vagyunk mindenhol, ahol ti.
      </p>
      <p>
        Új riportjainkról elsőként értesülhetsz, ha feliratkozol a
        YouTube-csatornára.
      </p>
      {
        socialCount > 0 && (
          <div class="social-wrapper">
            <Socials />
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply my-2;
  }
  .hero-buttons {
    @apply mt-4 flex flex-wrap gap-4;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col sm:flex-row sm:items-center;
  }

  /* ===== Featured & Recent Posts Sections ===== */
  #featured,
  #recent-posts,
  #mit-csinalunk,
  #hol-talalsz {
    @apply pb-6 pt-12;
  }
  #featured h2,
  #recent-posts h2,
  #mit-csinalunk h2,
  #hol-talalsz h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  #mit-csinalunk p,
  #hol-talalsz p {
    @apply my-2;
  }
  .all-posts-btn-wrapper {
    @apply my-8 text-center;
  }
</style>
